*.pt
*.pth

# Media artifacts
*.wav
*.mp3
*.mp4
*.mov
*.webm

# YouTube: OAuth client and tokens must live OUTSIDE this repository.
# These rules are defense in depth; arbitrary channel token filenames cannot be
# reliably ignored by pattern alone.
**/client_secret.json
/youtube-keystore/
/keystores/
/config/youtube/
**/.youtube-token-*.tmp

# Local-only YouTube upload attempt receipts and temporary atomic state.
**/*.youtube-upload-attempt.json
**/.youtube-attempt-*.tmp

# Secret-free but operationally sensitive YouTube publishing state.
**/youtube_publish.json
**/*.youtube_publish.json
**/youtube_publish_error.json
**/.youtube-state-*.tmp
/youtube-publications/
