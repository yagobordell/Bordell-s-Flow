# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example
/config/app.env
/config/salad.env

# IDE / OS
.vscode/
.idea/
.DS_Store

# Local runtime data; keep only the avatar folder's instructions in Git
.video_factory_work/
data/*
!data/input/
data/input/*
!data/avatar/
data/avatar/*
!data/avatar/README.md

# Remotion / Node
remotion/node_modules/
remotion/.cache/
remotion/out/
remotion/public/media/*
!remotion/public/media/.gitkeep

# Model caches / large artifacts
models/
.cache/
*.safetensors
*.ckpt
*.pt
*.pth

# Media artifacts
*.wav
*.mp3
*.mp4
*.mov
*.webm

# YouTube: OAuth client and tokens must live OUTSIDE this repository.
# These rules are defense in depth; arbitrary channel token filenames cannot be
# reliably ignored by pattern alone.
**/client_secret.json
/youtube-keystore/
/keystores/
/config/youtube/
**/.youtube-token-*.tmp

# Local-only YouTube upload attempt receipts and temporary atomic state.
**/*.youtube-upload-attempt.json
**/.youtube-attempt-*.tmp
