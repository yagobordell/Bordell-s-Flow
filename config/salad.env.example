# Blank local template. Fill only the Salad settings needed for your account or deployment.

# Non-secret Salad service, capacity and autoscaler configuration.

# Salad compatibility settings
SALAD_QUEUE_NAME=
SALAD_LOG_LEVEL=
SALAD_QUEUE_ENABLED=

# Salad autoscaler limits and timing
# Optional custom Salad GPU rates; blank uses the provider public price.
SALAD_LTX25_USD_PER_GPU_HOUR=
SALAD_LTX25_I2V_USD_PER_GPU_HOUR=

SALAD_AUTOSCALER_ENABLED=
SALAD_AUTOSCALER_PROJECT_MAX_REPLICAS=
SALAD_AUTOSCALER_LTX25_I2V_MAX_REPLICAS=
SALAD_AUTOSCALER_LTX25_MAX_REPLICAS=
SALAD_AUTOSCALER_LTX25_I2V_COLD_START_SECONDS=
SALAD_AUTOSCALER_LTX25_COLD_START_SECONDS=
SALAD_AUTOSCALER_LTX25_I2V_RUNTIME_SECONDS=
SALAD_AUTOSCALER_LTX25_RUNTIME_SECONDS=
SALAD_AUTOSCALER_ZERO_DEMAND_STABLE_POLLS=
SALAD_AUTOSCALER_DRAIN_GRACE_SECONDS=

# Pinned Salad worker image digests
SALAD_LTX25_SAFE_A2V_IMAGE=
SALAD_LTX25_AUTOTILING_A2V_IMAGE=
SALAD_LTX25_DIAGNOSTIC_A2V_IMAGE=
SALAD_LTX25_PAGEABLE_A2V_IMAGE=
# Current professional run-v2 A2V image: Triton + progressive Stage2 group8.
# Must be a NEW immutable digest containing the promoted run-v2 code.
SALAD_LTX25_RUN_V2_IMAGE=
# Historical run-v1 pin retained only for old/replayable jobs; run-v2 rejects it.
SALAD_LTX25_RUN_STATIC_FP8_IMAGE=
# Immutable digest of the standard Dockerfile image tested with fast-vanilla-none.
# Only checked for new I2V jobs; A2V remains on its separate pinned worker.
SALAD_LTX25_FP8_I2V_IMAGE=

# Salad image upscaler endpoint
IMAGE_UPSCALER_URL=
# Start the existing independent Salad group when professional images need x2.
# Set false to require manual startup. This does not stop the GPU after a run.
IMAGE_UPSCALER_AUTO_START=true
