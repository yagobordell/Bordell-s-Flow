# Blank local template. Empty values leave application defaults in effect; set only needed overrides.

# Application, provider, worker and storage configuration.

# Application defaults
APP_ENV=
LOG_LEVEL=

# OpenAI model and generation defaults
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# B2-only reasoning override; blank uses the application default (high).
OPENAI_B2_REASONING_EFFORT=
OPENAI_SERVICE_TIER=
OPENAI_FALLBACK_SERVICE_TIER=
OPENAI_IMAGE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_ALIGNMENT_MODEL=

# AI33 provider endpoint
AI33_BASE_URL=

# Output paths
OUTPUT_DIR=
TEMP_DIR=

# GPU worker and local object storage
GPU_WORKER_MODE=
GPU_WORKER_TEMP_DIR=
GPU_WORKER_LEASE_SECONDS=
GPU_WORKER_HEARTBEAT_SECONDS=
GPU_WORKER_MAX_DB_CONNECTIONS=
LOCAL_OBJECT_ROOT=

# Cloudflare R2 location; access credentials stay in .env
R2_ENDPOINT_URL=
R2_BUCKET=

# Fish Speech reference voice metadata
FISH_SPEECH_REFERENCE_PROFILE=
FISH_SPEECH_REFERENCE_AUDIO_KEY=
FISH_SPEECH_REFERENCE_AUDIO_SHA256=
FISH_SPEECH_REFERENCE_TRANSCRIPT=

# Optional YouTube publishing (secrets must remain in the external keystore)
# Defaults live in src/ai_video_factory/config.py. Set only needed overrides.
YOUTUBE_ENABLED=
YOUTUBE_KEYSTORE_DIR=
YOUTUBE_CHANNEL=
# Optional shared state directory; default: external sibling of YOUTUBE_KEYSTORE_DIR
YOUTUBE_STATE_DIR=
YOUTUBE_DEFAULT_PRIVACY=
YOUTUBE_DEFAULT_CATEGORY_ID=
YOUTUBE_DEFAULT_LANGUAGE=
YOUTUBE_MADE_FOR_KIDS=
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=
YOUTUBE_NOTIFY_SUBSCRIBERS=
YOUTUBE_EMBEDDABLE=
YOUTUBE_PUBLIC_STATS_VIEWABLE=
YOUTUBE_LICENSE=
