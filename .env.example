APP_ENV=development
LOG_LEVEL=INFO

# OpenAI structured reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
OPENAI_SERVICE_TIER=flex
OPENAI_FALLBACK_SERVICE_TIER=default

# OpenAI media providers. These remain temporarily while the Salad-backed
# Ideogram, Breeze TTS 2, and Whisper workers are introduced.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_ALIGNMENT_MODEL=whisper-1

# Proveedores futuros
AI33_API_KEY=
AI33_BASE_URL=

# Directorios
OUTPUT_DIR=data/output
TEMP_DIR=data/tmp

# Shared inference worker core. New model-specific workers use these names.
INFERENCE_WORKER_MODE=local
INFERENCE_WORKER_TEMP_DIR=/tmp/ai-video-factory
INFERENCE_WORKER_LEASE_SECONDS=90
INFERENCE_WORKER_HEARTBEAT_SECONDS=30
INFERENCE_WORKER_MAX_DB_CONNECTIONS=4
INFERENCE_LOCAL_OBJECT_ROOT=data/inference-local

# Legacy GPU/LTX compatibility settings. These remain until the LTX container is
# moved to its final model-specific worker in the next migration block.
GPU_WORKER_MODE=local
GPU_WORKER_RUNTIME=phase7
GPU_WORKER_TEMP_DIR=/tmp/ai-video-factory
GPU_WORKER_LEASE_SECONDS=90
GPU_WORKER_HEARTBEAT_SECONDS=30
GPU_WORKER_MAX_DB_CONNECTIONS=4
LOCAL_OBJECT_ROOT=data/phase7-local

# Phase 8 LTX-2.5 runtime. The production image overrides these with the validated values.
LTX_MODEL_ROOT=/workspace/models/ltx-2.5
LTX_MODEL_REPOSITORY=Lightricks/LTX-2.5
LTX_DEVICE=cuda

# Cloudflare R2
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ai-video-factory
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PHASE7_BENCHMARK_R2_PREFIX=phase7/benchmarks/rtx5090-cloud

# Supabase/Postgres (use the dashboard's Direct or Session pooler URI)
POSTGRES_DSN=

# SaladCloud; consumed by the deployment and smoke scripts, not the worker API.
SALAD_API_KEY=
SALAD_ORGANIZATION=
SALAD_PROJECT=
SALAD_QUEUE_NAME=ai-video-factory-jobs
SALAD_PRIORITY=high
SALAD_LOG_LEVEL=info
SALAD_QUEUE_ENABLED=false
