APP_ENV=development
LOG_LEVEL=INFO

# OpenAI structured reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
OPENAI_SERVICE_TIER=flex
OPENAI_FALLBACK_SERVICE_TIER=default

# Active image generator: Qwen-Image-2.1 on Salad.
QWEN_IMAGE_21_MODEL=Qwen/Qwen-Image-2.1
QWEN_IMAGE_21_MODEL_ROOT=/workspace/models/qwen-image-2.1
QWEN_IMAGE_21_MODEL_REPOSITORY=Qwen/Qwen-Image-2.1
QWEN_IMAGE_21_MODEL_REVISION=b3179ad355be050328e483a9dfdd9e60cd62adfa
QWEN_IMAGE_21_DEVICE=cuda

# Dedicated Ideogram 4 Quality image client/worker. Retained for future use only. The HF model is gated and
# requires accepting the Ideogram 4 non-commercial license before HF_TOKEN works.
IDEOGRAM4_MODEL=ideogram-ai/ideogram-4-nf4
IDEOGRAM_MODEL_ROOT=/workspace/models/ideogram4
IDEOGRAM_MODEL_REPOSITORY=ideogram-ai/ideogram-4-nf4
IDEOGRAM_MODEL_REVISION=main
IDEOGRAM_DEVICE=cuda
IDEOGRAM_DTYPE=bfloat16
IDEOGRAM_SAMPLER_PRESET=V4_QUALITY_48
HF_TOKEN=

# Dedicated Breeze TTS 2 narration client/worker.
BREEZE_TTS_MODEL=BreezeBlue/Breeze-TTS-2
BREEZE_TTS_VOICE="A warm, confident documentary narrator with a clear neutral English accent, natural low-mid register, crisp articulation, and restrained cinematic presence"
BREEZE_TTS_CFG_SCALE=4.0
BREEZE_TTS_SEED=42
BREEZE_MODEL_ROOT=/workspace/models/breeze-tts-2
BREEZE_MODEL_REPOSITORY=BreezeBlue/Breeze-TTS-2
BREEZE_MODEL_REVISION=main
BREEZE_RUNTIME_ROOT=/opt/breeze-infer
BREEZE_DEVICE=cuda
BREEZE_MAX_CHUNK_CHARS=1200
BREEZE_INTER_CHUNK_PAUSE_MS=120

# Dedicated Fish Speech S2 Pro fallback. These reference values are persistent
# deployment configuration; they do not change per video unless the voice asset changes.
FISH_SPEECH_MODEL=fishaudio/s2-pro
FISH_SPEECH_SEED=42
FISH_SPEECH_REFERENCE_PROFILE=project-narrator-v1
FISH_SPEECH_REFERENCE_AUDIO_KEY=voices/project-narrator-v1.wav
FISH_SPEECH_REFERENCE_AUDIO_SHA256=
FISH_SPEECH_REFERENCE_TRANSCRIPT=

# Dedicated Whisper transcription client/worker.
WHISPER_MODEL=openai/whisper-large-v3-turbo
WHISPER_MODEL_ROOT=/workspace/models/whisper-large-v3-turbo
WHISPER_MODEL_REPOSITORY=openai/whisper-large-v3-turbo
WHISPER_MODEL_REVISION=main
WHISPER_DEVICE=cuda:0
WHISPER_DTYPE=float16

# Directorios
OUTPUT_DIR=data/output
TEMP_DIR=data/tmp

# Shared inference worker core. Every model-specific worker uses these names.
INFERENCE_WORKER_MODE=local
INFERENCE_WORKER_TEMP_DIR=/tmp/ai-video-factory
INFERENCE_WORKER_LEASE_SECONDS=90
INFERENCE_WORKER_HEARTBEAT_SECONDS=30
INFERENCE_WORKER_MAX_DB_CONNECTIONS=4
# Production overrides these in deploy/salad/services.json.
INFERENCE_WORKER_POLL_JOBS=false
INFERENCE_WORKER_JOB_POLL_SECONDS=2
INFERENCE_LOCAL_OBJECT_ROOT=data/inference-local
INFERENCE_CLIENT_POLL_SECONDS=5
INFERENCE_CLIENT_TIMEOUT_SECONDS=3600

# Dedicated LTX-2.5 worker.
LTX_MODEL_ROOT=/workspace/models/ltx-2.5
LTX_MODEL_REPOSITORY=Lightricks/LTX-2.5
LTX_MODEL_REVISION=main
LTX_DEVICE=cuda

# Cloudflare R2. The unified Salad deployment manager loads these values from
# .env once and reuses them across every selected worker. Local orchestration
# preflights R2 before allocating a GPU and uses bounded network waits.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ai-video-factory
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=30
R2_TOTAL_MAX_ATTEMPTS=3
R2_MAX_POOL_CONNECTIONS=32

# Supabase/Postgres used by workers and ordinary job traffic.
POSTGRES_DSN=
# Capacity-controller leadership must keep one Postgres session alive. Prefer a
# dedicated Direct or Session-mode URI here. If omitted, POSTGRES_DSN is used.
# Supabase transaction pooling on port 6543 is rejected explicitly.
SALAD_CAPACITY_CONTROLLER_POSTGRES_DSN=

# SaladCloud is compute-only. Organization/project and service capacity are
# canonical in deploy/salad/services.json; jobs and leases live in Postgres.
SALAD_API_KEY=
# Run exactly one long-lived controller process with this enabled.
SALAD_AUTOSCALER_ENABLED=false
# Set an explicit production-wide GPU budget before rollout. The code warns when this
# value does not constrain the sum of per-service maxima.
SALAD_AUTOSCALER_PROJECT_MAX_REPLICAS=
SALAD_AUTOSCALER_TARGET_DRAIN_MINUTES=20
SALAD_AUTOSCALER_COLD_START_SECONDS=180
SALAD_CAPACITY_CONTROLLER_MAX_HEARTBEAT_AGE_SECONDS=120
SALAD_CAPACITY_CONTROLLER_MAX_RECONCILE_AGE_SECONDS=120
SALAD_AUTOSCALER_DRAIN_GRACE_SECONDS=5
SALAD_AUTOSCALER_DRAIN_TTL_SECONDS=120
# Persistent mapping/idle-capacity deferrals become controller failures after this many polls.
SALAD_AUTOSCALER_NONCONVERGENCE_FAILURE_POLLS=4
# Optional per-service cold-start overrides, calibrated from real Salad measurements.
SALAD_AUTOSCALER_QWEN_IMAGE_21_COLD_START_SECONDS=
SALAD_AUTOSCALER_LTX25_COLD_START_SECONDS=
