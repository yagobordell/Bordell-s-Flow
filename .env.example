APP_ENV=development
LOG_LEVEL=INFO


# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_SERVICE_TIER=flex
OPENAI_FALLBACK_SERVICE_TIER=default
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_ALIGNMENT_MODEL=whisper-1


# Proveedores futuros
AI33_API_KEY=
AI33_BASE_URL=


# Directorios
OUTPUT_DIR=
TEMP_DIR=


# Phase 7 GPU worker. Keep production secrets outside version control.
GPU_WORKER_MODE=
GPU_WORKER_TEMP_DIR=
GPU_WORKER_LEASE_SECONDS=
GPU_WORKER_HEARTBEAT_SECONDS=
GPU_WORKER_MAX_DB_CONNECTIONS=
LOCAL_OBJECT_ROOT=


# Cloudflare R2
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# Supabase/Postgres (use the dashboard's Direct or Session pooler URI)
POSTGRES_DSN=


