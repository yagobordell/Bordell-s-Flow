APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_ALIGNMENT_MODEL=whisper-1

# Proveedores futuros
AI33_API_KEY=
AI33_BASE_URL=

# Directorios
OUTPUT_DIR=data/output
TEMP_DIR=data/tmp

# Phase 7 GPU worker. Keep production secrets outside version control.
GPU_WORKER_MODE=local
GPU_WORKER_TEMP_DIR=/tmp/ai-video-factory
GPU_WORKER_LEASE_SECONDS=90
GPU_WORKER_HEARTBEAT_SECONDS=30
GPU_WORKER_MAX_DB_CONNECTIONS=4
LOCAL_OBJECT_ROOT=data/phase7-local

# Cloudflare R2
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ai-video-factory
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PHASE7_BENCHMARK_R2_PREFIX=phase7/benchmarks/rtx5090-cloud

# Supabase/Postgres (use the dashboard's Direct or Session pooler URI)
POSTGRES_DSN=

# SaladCloud; consumed by the deployment and smoke scripts, not the worker API.
SALAD_API_KEY=
SALAD_ORGANIZATION=
SALAD_PROJECT=
SALAD_QUEUE_NAME=ai-video-factory-jobs
SALAD_PRIORITY=high
SALAD_LOG_LEVEL=info
SALAD_QUEUE_ENABLED=false
