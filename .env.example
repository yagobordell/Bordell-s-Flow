APP_ENV=development
LOG_LEVEL=INFO

# OpenAI structured reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
OPENAI_SERVICE_TIER=flex
OPENAI_FALLBACK_SERVICE_TIER=default

# OpenAI media compatibility providers. Production image/TTS paths migrate to Salad workers.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Dedicated Breeze TTS 2 narration client/worker.
BREEZE_TTS_MODEL=BreezeBlue/Breeze-TTS-2
BREEZE_TTS_VOICE="A warm, confident documentary narrator with a clear neutral English accent, natural low-mid register, crisp articulation, and restrained cinematic presence"
BREEZE_TTS_CFG_SCALE=4.0
BREEZE_TTS_SEED=42
BREEZE_MODEL_ROOT=/workspace/models/breeze-tts-2
BREEZE_MODEL_REPOSITORY=BreezeBlue/Breeze-TTS-2
BREEZE_MODEL_REVISION=main
BREEZE_RUNTIME_ROOT=/opt/breeze-infer
BREEZE_DEVICE=cuda
BREEZE_MAX_CHUNK_CHARS=1200
BREEZE_INTER_CHUNK_PAUSE_MS=120

# Dedicated Whisper transcription client/worker.
WHISPER_MODEL=openai/whisper-large-v3-turbo
WHISPER_MODEL_ROOT=/workspace/models/whisper-large-v3-turbo
WHISPER_MODEL_REPOSITORY=openai/whisper-large-v3-turbo
WHISPER_MODEL_REVISION=main
WHISPER_DEVICE=cuda:0
WHISPER_DTYPE=float16

# Proveedores futuros
AI33_API_KEY=
AI33_BASE_URL=

# Directorios
OUTPUT_DIR=data/output
TEMP_DIR=data/tmp

# Shared inference worker core. Every model-specific worker uses these names.
INFERENCE_WORKER_MODE=local
INFERENCE_WORKER_TEMP_DIR=/tmp/ai-video-factory
INFERENCE_WORKER_LEASE_SECONDS=90
INFERENCE_WORKER_HEARTBEAT_SECONDS=30
INFERENCE_WORKER_MAX_DB_CONNECTIONS=4
INFERENCE_LOCAL_OBJECT_ROOT=data/inference-local
INFERENCE_CLIENT_POLL_SECONDS=5
INFERENCE_CLIENT_TIMEOUT_SECONDS=3600

# Legacy Phase 7 worker compatibility settings.
GPU_WORKER_MODE=local
GPU_WORKER_RUNTIME=phase7
GPU_WORKER_TEMP_DIR=/tmp/ai-video-factory
GPU_WORKER_LEASE_SECONDS=90
GPU_WORKER_HEARTBEAT_SECONDS=30
GPU_WORKER_MAX_DB_CONNECTIONS=4
LOCAL_OBJECT_ROOT=data/phase7-local

# Dedicated LTX-2.5 worker.
LTX_MODEL_ROOT=/workspace/models/ltx-2.5
LTX_MODEL_REPOSITORY=Lightricks/LTX-2.5
LTX_MODEL_REVISION=main
LTX_DEVICE=cuda

# Cloudflare R2
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ai-video-factory
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PHASE7_BENCHMARK_R2_PREFIX=phase7/benchmarks/rtx5090-cloud

# Supabase/Postgres (use the dashboard's Direct or Session pooler URI)
POSTGRES_DSN=

# SaladCloud; consumed by deployment/orchestrator scripts, not the worker HTTP API.
SALAD_API_KEY=
SALAD_ORGANIZATION=
SALAD_PROJECT=
SALAD_QUEUE_NAME=ai-video-factory-jobs
SALAD_LTX25_QUEUE_NAME=ai-video-factory-ltx25-jobs
SALAD_BREEZE_TTS2_QUEUE_NAME=ai-video-factory-breeze-tts2-jobs
SALAD_WHISPER_QUEUE_NAME=ai-video-factory-whisper-jobs
SALAD_PRIORITY=high
SALAD_LOG_LEVEL=info
SALAD_QUEUE_ENABLED=false
