{
  "schema_version": 3,
  "stack": {
    "organization": "yagobordellorg",
    "project": "aivideofactory",
    "service_order": [
      "whisper",
      "breeze_tts2",
      "fish_speech",
      "ideogram4",
      "qwen_image_21",
      "ltx25",
      "realesrgan"
    ],
    "shared_required_environment": [
      "POSTGRES_DSN",
      "R2_ENDPOINT_URL",
      "R2_BUCKET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ],
    "shared_environment": {
      "INFERENCE_WORKER_MODE": "production",
      "INFERENCE_WORKER_HEARTBEAT_SECONDS": "30",
      "INFERENCE_WORKER_POLL_JOBS": "true",
      "INFERENCE_WORKER_JOB_POLL_SECONDS": "2"
    },
    "shared_liveness_probe": {
      "path": "/health",
      "period_seconds": 30,
      "timeout_seconds": 10,
      "failure_threshold": 20
    },
    "autostart_policy": false,
    "restart_policy": "always",
    "container_port": 8080,
    "job_transport": "postgres"
  },
  "services": {
    "ltx25": {
      "display_name": "AI Video Factory LTX 2.5",
      "group_name": "ai-video-factory-ltx25-worker-v2",
      "dockerfile": "docker/workers/ltx25/Dockerfile",
      "image": "docker.io/yagobordell/ai-video-factory:ltx25-a2v-torch211-cu128-eagersdpa-xet-fast-v9",
      "priority": "high",
      "resources": {
        "cpu": 8,
        "memory": 61440,
        "shm_size": 8192,
        "storage_amount": 171798691840,
        "gpu_class_names": [
          "RTX 5090 (32 GB)"
        ]
      },
      "environment": {
        "INFERENCE_WORKER_LEASE_SECONDS": "900",
        "LTX_MODEL_ROOT": "/workspace/models/ltx-2.5",
        "LTX_MODEL_REPOSITORY": "Lightricks/LTX-2.5",
        "LTX_MODEL_REVISION": "main",
        "LTX_DEVICE": "cuda",
        "PYTHONFAULTHANDLER": "1",
        "SALAD_NETWORK_MIN_DOWNLOAD_MBPS": "100",
        "SALAD_NETWORK_TEST_BYTES": "25000000",
        "SALAD_NETWORK_TEST_ATTEMPTS": "3",
        "SALAD_NETWORK_TEST_DELAY_SECONDS": "5",
        "LTX_MODEL_DOWNLOAD_MIN_PROGRESS_RESET_BYTES": "67108864",
        "LTX_MODEL_DOWNLOAD_MIN_THROUGHPUT_MIBPS": "8",
        "LTX_MODEL_DOWNLOAD_THROUGHPUT_GRACE_SECONDS": "300",
        "LTX_MODEL_DOWNLOAD_THROUGHPUT_WINDOW_SECONDS": "180",
        "SALAD_NETWORK_TEST_URL": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/diffusion_models/ltx-2.5-22b-distilled-transformer-bf16.safetensors",
        "HF_XET_CLIENT_ENABLE_ADAPTIVE_CONCURRENCY": "true",
        "HF_HUB_DOWNLOAD_TIMEOUT": "60",
        "HF_HUB_ETAG_TIMEOUT": "15"
      },
      "required_environment": [
        "HF_TOKEN"
      ],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 15,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 6
        }
      },
      "capacity": {
        "start_replicas": 1,
        "max_replicas": 4
      }
    },
    "breeze_tts2": {
      "display_name": "AI Video Factory Breeze TTS 2",
      "group_name": "ai-video-factory-breeze-tts2-worker-v2",
      "dockerfile": "docker/workers/breeze-tts2/Dockerfile",
      "image": "docker.io/yagobordell/ai-video-factory:breeze-tts2-fast-decode-v6",
      "priority": "high",
      "resources": {
        "cpu": 8,
        "memory": 32768,
        "shm_size": 8192,
        "storage_amount": 68719476736,
        "gpu_class_names": [
          "RTX 4090 (24 GB)"
        ]
      },
      "environment": {
        "INFERENCE_WORKER_LEASE_SECONDS": "900",
        "BREEZE_MODEL_ROOT": "/workspace/models/breeze-tts-2",
        "BREEZE_MODEL_REPOSITORY": "BreezeBlue/Breeze-TTS-2",
        "BREEZE_MODEL_REVISION": "main",
        "BREEZE_RUNTIME_ROOT": "/opt/breeze-infer",
        "BREEZE_DEVICE": "cuda:0",
        "BREEZE_MAX_CHUNK_CHARS": "1200",
        "BREEZE_INTER_CHUNK_PAUSE_MS": "120",
        "BREEZE_DOWNLOAD_STALL_TIMEOUT_SECONDS": "300",
        "BREEZE_DOWNLOAD_HARD_TIMEOUT_SECONDS": "1200",
        "BREEZE_DOWNLOAD_POLL_SECONDS": "15",
        "BREEZE_DOWNLOAD_MIN_MIBPS": "6",
        "BREEZE_DOWNLOAD_THROUGHPUT_GRACE_SECONDS": "120",
        "BREEZE_DOWNLOAD_THROUGHPUT_WINDOW_SECONDS": "90",
        "HF_HUB_DOWNLOAD_TIMEOUT": "120",
        "HF_HUB_ETAG_TIMEOUT": "30"
      },
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 12
        }
      },
      "capacity": {
        "start_replicas": 1,
        "max_replicas": 2
      }
    },
