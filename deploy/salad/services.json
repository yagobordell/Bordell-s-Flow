        "IDEOGRAM_BOOTSTRAP_POLL_SECONDS": "15",
        "IDEOGRAM_BOOTSTRAP_REALLOCATE_ON_STALL": "true",
        "HF_HUB_DOWNLOAD_TIMEOUT": "120",
        "HF_HUB_ETAG_TIMEOUT": "30"
      },
      "required_environment": [
        "HF_TOKEN"
      ],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 30,
          "timeout_seconds": 5,
          "failure_threshold": 20
        }
      },
      "capacity": {
        "start_replicas": 1,
        "max_replicas": 1
      }
    },
