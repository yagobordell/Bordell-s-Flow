{
  "schema_version": "2",
  "stack": {
    "organization": "yagobordellorg",
    "project": "aivideofactory",
    "service_order": [
      "whisper",
      "breeze_tts2",
      "ideogram4",
      "ltx25"
    ],
    "shared_required_environment": [
      "POSTGRES_DSN",
      "R2_ENDPOINT_URL",
      "R2_BUCKET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ],
    "autostart_policy": false,
    "restart_policy": "always",
    "queue_path": "/jobs",
    "container_port": 8080
  },
  "services": {
    "ltx25": {
      "display_name": "AI Video Factory LTX 2.5",
      "group_name": "ai-video-factory-worker",
      "queue_name": "ai-video-factory-ltx25-jobs",
      "dockerfile": "docker/workers/ltx25/Dockerfile",
      "image": "docker.io/yagobordell/ai-video-factory:ltx25-torch211-cu128-natten0216-v2",
      "priority": "medium",
      "resources": {
        "cpu": 8,
        "memory": 61440,
        "shm_size": 8192,
        "storage_amount": 137438953472,
        "gpu_class_names": [
          "RTX 5090 (32 GB)"
        ]
      },
      "environment": {
        "INFERENCE_WORKER_MODE": "production",
        "INFERENCE_WORKER_LEASE_SECONDS": "900",
        "INFERENCE_WORKER_HEARTBEAT_SECONDS": "30",
        "LTX_MODEL_ROOT": "/workspace/models/ltx-2.5",
        "LTX_MODEL_REPOSITORY": "Lightricks/LTX-2.5",
        "LTX_MODEL_REVISION": "main",
        "LTX_DEVICE": "cuda",
        "SALAD_QUEUE_ENABLED": "true",
        "SALAD_LOG_LEVEL": "info"
      },
      "required_environment": [
        "HF_TOKEN"
      ],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 15,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 6
        },
        "liveness": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 10,
          "failure_threshold": 20
        }
      },
      "autoscaler": {
        "min_replicas": 0,
        "max_replicas": 4,
        "desired_queue_length": 1,
        "polling_period": 30,
        "max_upscale_per_minute": 2,
        "max_downscale_per_minute": 1
      }
    },
    "breeze_tts2": {
      "display_name": "AI Video Factory Breeze TTS 2",
      "group_name": "ai-video-factory-breeze-tts2-worker",
      "queue_name": "ai-video-factory-breeze-tts2-jobs",
      "dockerfile": "docker/workers/breeze-tts2/Dockerfile",
      "image": "docker.io/yagobordell/ai-video-factory:breeze-tts2-fast-all-v1",
      "priority": "medium",
      "resources": {
        "cpu": 8,
        "memory": 32768,
        "shm_size": 8192,
        "storage_amount": 68719476736,
        "gpu_class_names": [
          "RTX 4090 (24 GB)"
        ]
      },
      "environment": {
        "INFERENCE_WORKER_MODE": "production",
        "INFERENCE_WORKER_LEASE_SECONDS": "900",
        "INFERENCE_WORKER_HEARTBEAT_SECONDS": "30",
        "BREEZE_MODEL_ROOT": "/workspace/models/breeze-tts-2",
        "BREEZE_MODEL_REPOSITORY": "BreezeBlue/Breeze-TTS-2",
        "BREEZE_MODEL_REVISION": "main",
        "BREEZE_RUNTIME_ROOT": "/opt/breeze-infer",
        "BREEZE_DEVICE": "cuda",
        "BREEZE_MAX_CHUNK_CHARS": "1200",
        "BREEZE_INTER_CHUNK_PAUSE_MS": "120",
        "SALAD_QUEUE_ENABLED": "true",
        "SALAD_LOG_LEVEL": "info"
      },
      "required_environment": [],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 12
        },
        "liveness": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 10,
          "failure_threshold": 20
        }
      },
      "autoscaler": {
        "min_replicas": 0,
        "max_replicas": 2,
        "desired_queue_length": 1,
        "polling_period": 30,
        "max_upscale_per_minute": 1,
        "max_downscale_per_minute": 1
      }
    },
    "ideogram4": {
      "display_name": "AI Video Factory Ideogram 4 Quality",
      "group_name": "ai-video-factory-ideogram4-worker",
      "queue_name": "ai-video-factory-ideogram4-jobs",
      "dockerfile": "docker/workers/ideogram4/Dockerfile",
      "image": "docker.io/yagobordell/ai-video-factory:ideogram4-nf4-quality48-v1",
      "priority": "medium",
      "resources": {
        "cpu": 8,
        "memory": 32768,
        "shm_size": 8192,
        "storage_amount": 103079215104,
        "gpu_class_names": [
          "RTX 4090 (24 GB)"
        ]
      },
      "environment": {
        "INFERENCE_WORKER_MODE": "production",
        "INFERENCE_WORKER_LEASE_SECONDS": "900",
        "INFERENCE_WORKER_HEARTBEAT_SECONDS": "30",
        "IDEOGRAM_MODEL_ROOT": "/workspace/models/ideogram4",
        "IDEOGRAM_MODEL_REPOSITORY": "ideogram-ai/ideogram-4-nf4",
        "IDEOGRAM_MODEL_REVISION": "main",
        "IDEOGRAM_DEVICE": "cuda",
        "IDEOGRAM_DTYPE": "bfloat16",
        "IDEOGRAM_SAMPLER_PRESET": "V4_QUALITY_48",
        "SALAD_QUEUE_ENABLED": "true",
        "SALAD_LOG_LEVEL": "info"
      },
      "required_environment": [
        "HF_TOKEN"
      ],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 30,
          "timeout_seconds": 5,
          "failure_threshold": 20
        },
        "liveness": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 10,
          "failure_threshold": 20
        }
      },
      "autoscaler": {
        "min_replicas": 0,
        "max_replicas": 4,
        "desired_queue_length": 1,
        "polling_period": 30,
        "max_upscale_per_minute": 2,
        "max_downscale_per_minute": 1
      }
    },
    "whisper": {
      "display_name": "AI Video Factory Whisper",
      "group_name": "ai-video-factory-whisper-worker",
      "queue_name": "ai-video-factory-whisper-jobs",
      "dockerfile": "docker/workers/whisper/Dockerfile",
      "image": "docker.io/yagobordell/ai-video-factory:whisper-large-v3-turbo-v1",
      "priority": "medium",
      "resources": {
        "cpu": 4,
        "memory": 16384,
        "shm_size": 4096,
        "storage_amount": 34359738368,
        "gpu_class_names": [
          "RTX 3090 (24 GB)"
        ]
      },
      "environment": {
        "INFERENCE_WORKER_MODE": "production",
        "INFERENCE_WORKER_LEASE_SECONDS": "300",
        "INFERENCE_WORKER_HEARTBEAT_SECONDS": "30",
        "WHISPER_MODEL_ROOT": "/workspace/models/whisper-large-v3-turbo",
        "WHISPER_MODEL_REPOSITORY": "openai/whisper-large-v3-turbo",
        "WHISPER_MODEL_REVISION": "main",
        "WHISPER_DEVICE": "cuda:0",
        "WHISPER_DTYPE": "float16",
        "SALAD_QUEUE_ENABLED": "true",
        "SALAD_LOG_LEVEL": "info"
      },
      "required_environment": [],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 18
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 6
        },
        "liveness": {
          "path": "/health",
          "period_seconds": 30,
          "timeout_seconds": 10,
          "failure_threshold": 20
        }
      },
      "autoscaler": {
        "min_replicas": 0,
        "max_replicas": 1,
        "desired_queue_length": 1,
        "polling_period": 30,
        "max_upscale_per_minute": 1,
        "max_downscale_per_minute": 1
      }
    }
  }
}
