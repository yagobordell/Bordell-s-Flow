        "IDEOGRAM_DEVICE": "cuda",
        "IDEOGRAM_DTYPE": "bfloat16",
        "IDEOGRAM_SAMPLER_PRESET": "V4_QUALITY_48",
        "IDEOGRAM_DOWNLOAD_STALL_TIMEOUT_SECONDS": "600",
        "IDEOGRAM_DOWNLOAD_HARD_TIMEOUT_SECONDS": "1800",
        "IDEOGRAM_DOWNLOAD_POLL_SECONDS": "15",
        "IDEOGRAM_DOWNLOAD_MIN_MIBPS": "8",
        "IDEOGRAM_DOWNLOAD_THROUGHPUT_GRACE_SECONDS": "180",
        "IDEOGRAM_DOWNLOAD_THROUGHPUT_WINDOW_SECONDS": "120",
        "IDEOGRAM_BOOTSTRAP_STATUS_PATH": "/tmp/ai-video-factory/ideogram-bootstrap.json",
