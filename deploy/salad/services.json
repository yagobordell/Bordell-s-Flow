        "HF_HUB_ETAG_TIMEOUT": "30",
        "HF_HUB_DISABLE_XET": "1"
      },
      "required_environment": [
        "HF_TOKEN"
      ],
      "probes": {
        "startup": {
          "path": "/health",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 18
        },
        "readiness": {
          "path": "/ready",
          "period_seconds": 10,
          "timeout_seconds": 5,
          "failure_threshold": 6
        }
      },
      "capacity": {
        "start_replicas": 1,
        "max_replicas": 1
      }
